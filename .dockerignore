# Allowlist: everything is excluded, then the few paths the build needs are
# added back. Anything new — local environment files, credentials, build
# output — stays out of the build context by default rather than by memory.
*
!cmd/
!internal/
!go.mod
!go.sum
# Node is a validation tool, never a runtime dependency. The browser asset's
# test suite has no business in the image build context.
internal/beacon/jstest/
