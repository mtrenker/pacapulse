  "browser_extraction": [
    {
      "name": "GPC suppresses before network activity",
      "input": {
        "kind": "initial",
        "global_privacy_control": true,
        "url": "https://shop.example/"
      },
      "expected": {
        "send": false,
        "network": false
      }
    },
    {
      "name": "DNT suppresses without explicit snippet override",
      "input": {
        "kind": "initial",
        "do_not_track": "1",
        "data_collect_dnt": null,
        "url": "https://shop.example/"
      },
      "expected": {
        "send": false,
        "network": false
      }
    },
    {
      "name": "explicit browser DNT override emits one-way DNT field",
      "input": {
        "kind": "initial",
        "do_not_track": "1",
        "data_collect_dnt": "true",
        "url": "https://privacy-aware.example/"
      },
      "expected": {
        "send": true,
        "payload_fields": {
          "dnt": true
        }
      }
    },
    {
      "name": "initial page minimizes URL and referrer before transport",
      "input": {
        "kind": "initial",
        "url": "https://shop.example/Pricing/?utm_source=%20NewsLetter%20&utm_medium=EMAIL&utm_campaign=Spring%20Launch&customer=discard#details",
        "document_referrer": "https://Search.Example/results?q=private"
      },
      "expected": {
        "path": "/Pricing/",
        "referrer_host": "search.example",
        "utm_source": "newsletter",
        "utm_medium": "email",
        "utm_campaign": "spring launch",
        "route_key_fields": [
          "/Pricing/",
          "newsletter",
          "email",
          "spring launch"
        ]
      }
    },
    {
      "name": "percent escapes are uppercased but not decoded",
      "input": {
        "kind": "initial",
        "url": "https://shop.example/docs/%7euser",
        "document_referrer": ""
      },
      "expected": {
        "path": "/docs/%7Euser",
        "route_key_fields": [
          "/docs/%7Euser",
          "",
          "",
          ""
        ]
      }
    },
    {
      "name": "duplicate allowlisted query key is omitted",
      "input": {
        "kind": "initial",
        "url": "https://shop.example/?utm_source=first&utm_source=second&utm_medium=email",
        "document_referrer": "https://www.shop.example/internal"
      },
      "expected": {
        "path": "/",
        "referrer_host": "www.shop.example",
        "utm_medium": "email",
        "route_key_fields": [
          "/",
          "",
          "email",
          ""
        ],
        "omitted": [
          "utm_source"
        ]
      }
    },
    {
      "name": "spa route omits original document referrer",
      "input": {
        "kind": "spa",
        "url": "https://shop.example/account?tab=billing&utm_campaign=retention",
        "document_referrer": "https://search.example/results"
      },
      "expected": {
        "path": "/account",
        "utm_campaign": "retention",
        "route_key_fields": [
          "/account",
          "",
          "",
          "retention"
        ],
        "omitted": [
          "referrer_host"
        ]
      }
    },
    {
      "name": "prerender waits for activation",
      "input": {
        "kind": "initial",
        "document_prerendering": true,
        "lifecycle_event": "none"
      },
      "expected": {
        "send": false,
        "wait_for": "prerenderingchange"
      }
    },
    {
      "name": "prerender activation sends the current route once",
      "input": {
        "kind": "initial",
        "document_prerendering": false,
        "lifecycle_event": "prerenderingchange",
        "url": "https://shop.example/activated",
        "document_referrer": "https://search.example/results?q=private"
      },
      "expected": {
        "send": true,
        "path": "/activated",
        "referrer_host": "search.example"
      }
    },
    {
      "name": "spa call during prerender is deferred",
      "input": {
        "kind": "spa",
        "document_prerendering": true,
        "url": "https://shop.example/prerender-route"
      },
      "expected": {
        "send": false,
        "wait_for": "prerenderingchange"
      }
    },
    {
      "name": "bfcache restoration creates a fresh no-referrer attempt",
      "input": {
        "kind": "pageshow",
        "persisted": true,
        "url": "https://shop.example/account",
        "document_referrer": "https://search.example/results"
      },
      "expected": {
        "send": true,
        "fresh_event_id": true,
        "reset_route_key": true,
        "path": "/account",
        "omitted": [
          "referrer_host"
        ]
      }
    },
    {
      "name": "second script injection is a no-op",
      "input": {
        "kind": "script_load",
        "existing_pacapulse_version": 1
      },
      "expected": {
        "send": false,
        "install_api": false
      }
    },
    {
      "name": "consecutive equal route key is suppressed",
      "input": {
        "previous_route_key_fields": [
          "/account",
          "",
          "",
          "retention"
        ],
        "kind": "spa",
        "url": "https://shop.example/account?ignored=changed&utm_campaign=retention#new-hash"
      },
      "expected": {
        "send": false
      }
    }
  ],
